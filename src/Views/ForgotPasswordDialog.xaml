<ContentDialog
    x:Class="KeySecBox.ForgotPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="恢复主密码"
    CloseButtonText="取消"
    Loaded="ContentDialog_Loaded">
    <StackPanel Spacing="16" Width="340">
        <TextBlock Text="请选择恢复方式或输入备用密码。" TextWrapping="Wrap"/>
        <Button x:Name="SystemUnlockBtn" Content="使用系统解锁（Windows Hello）" Click="SystemUnlockBtn_Click"/>
        <StackPanel Spacing="8">
            <TextBlock Text="或输入备用恢复密码：" FontSize="12"/>
            <PasswordBox x:Name="BackupPasswordBox" PlaceholderText="备用恢复密码"/>
            <Button x:Name="RecoverBtn" Content="恢复" Click="RecoverBtn_Click"/>
        </StackPanel>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>