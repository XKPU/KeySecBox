<ContentDialog
    x:Class="KeySecBox.EntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="条目"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <Grid Width="380">
        <!-- 单分类表单 -->
        <StackPanel x:Name="EntryPanel" Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="分类"/>
                <!-- 单选下拉 + 右侧「多分类」按钮 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                              HorizontalAlignment="Stretch"/>
                    <Button x:Name="MultiCatBtn" Grid.Column="1" Content="多分类"
                            Click="MultiCatBtn_Click" Padding="12,5"/>
                </Grid>
                <!-- 多分类模式：下拉变淡、只读，滚动展示所有选中分类 -->
                <StackPanel x:Name="MultiBar" Visibility="Collapsed" Opacity="0.65" Spacing="4">
                    <ScrollViewer MaxHeight="66" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MultiBarText" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <Button x:Name="ExitMultiCatBtn" Content="关闭多分类模式"
                            Click="ExitMultiCatBtn_Click" HorizontalAlignment="Stretch" Padding="12,5"/>
                </StackPanel>
                <!-- 下方新建分类 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewCatBox" PlaceholderText="新建分类" KeyDown="NewCatBox_KeyDown"/>
                    <Button Grid.Column="1" Content="新建分类" Click="NewCatBtn_Click" Padding="12,5"/>
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="账户名"/>
                <TextBox x:Name="AccountBox"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="密码"/>
                <PasswordBox x:Name="PasswordBox" PlaceholderText="支持无账号密码不填写"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="备注"/>
                <TextBox x:Name="NoteBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" PlaceholderText="可选"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="恢复密钥"/>
                <TextBox x:Name="RecoveryBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         PlaceholderText="每行一个，可留空，之后可在恢复密钥对话框中管理"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 多分类选择面板 -->
        <Border x:Name="MultiPanel" Visibility="Collapsed"
                Background="{ThemeResource ContentDialogBackground}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" MaxHeight="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 可滚动分类勾选区 -->
                <ScrollViewer Grid.Row="0" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                              Padding="14,14,14,4">
                    <StackPanel x:Name="MultiCatPanel" Spacing="0"/>
                </ScrollViewer>

                <!-- 固定底部：错误提示 + 新建分类 -->
                <StackPanel Grid.Row="1" Padding="14,4,14,14" Spacing="8">
                    <TextBlock x:Name="MultiErrorText" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MultiNewCatBox" PlaceholderText="新建分类" KeyDown="MultiNewCatBox_KeyDown"/>
                        <Button Grid.Column="1" Content="新建分类" Click="MultiNewCatBtn_Click" Padding="12,5"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
