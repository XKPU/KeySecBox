<ContentDialog
    x:Class="KeySecBox.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    Loaded="ContentDialog_Loaded">
    <StackPanel Spacing="16" Width="340">
        <StackPanel Spacing="6">
            <TextBlock Text="主题" FontWeight="SemiBold"/>
            <ComboBox x:Name="ThemeCombo" SelectedIndex="0">
                <ComboBoxItem>跟随系统</ComboBoxItem>
                <ComboBoxItem>浅色</ComboBoxItem>
                <ComboBoxItem>深色</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Text="动画帧率" FontWeight="SemiBold"/>
            <Slider x:Name="FrameRateSlider" Minimum="1" Maximum="120" Value="24" TickFrequency="1" TickPlacement="Outside"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>