<ContentDialog
    x:Class="KeySecBox.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="导入 CSV"
    PrimaryButtonText="导入"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <StackPanel Width="380" Spacing="12">
        <TextBlock x:Name="SubText" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel Spacing="4">
            <TextBlock Text="导入到分类"/>
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewCatBox" PlaceholderText="新建分类名称"/>
            <Button Grid.Column="1" Content="新建分类" Click="NewCatBtn_Click" Padding="12,5"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>