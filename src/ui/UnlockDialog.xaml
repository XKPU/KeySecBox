<ContentDialog
    x:Class="KeySecBox.UnlockDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KeySecBox"
    PrimaryButtonText="解锁"
    CloseButtonText="退出"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Loaded="ContentDialog_Loaded">

    <StackPanel Spacing="16" Width="340">
        <StackPanel Spacing="6">
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubText" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <StackPanel Spacing="10">
            <PasswordBox x:Name="PasswordBox" PlaceholderText="主密码"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
            <PasswordBox x:Name="ConfirmBox" PlaceholderText="再次输入主密码"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
        </StackPanel>
        <HyperlinkButton x:Name="ForgotPwdLink" Content="忘记密码？" Click="ForgotPwdLink_Click"
                         Visibility="Collapsed" HorizontalAlignment="Left"/>
        <ProgressBar x:Name="HintBar" Visibility="Collapsed" IsIndeterminate="True"/>
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="12" Visibility="Collapsed" TextWrapping="WrapWholeWords"/>
    </StackPanel>
</ContentDialog>