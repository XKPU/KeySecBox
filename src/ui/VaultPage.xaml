<Page
    x:Class="KeySecBox.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 分类导航 -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 新建分类 + 排序模式开关 -->
            <Grid Grid.Row="0" Margin="18,16,18,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AddCatBtn" Content="＋ 新建分类" HorizontalAlignment="Stretch"
                        Click="AddCatBtn_Click"/>
                <Button Grid.Column="1" x:Name="SortToggleBtn" Content="排序" Padding="14,5"
                        Click="SortToggleBtn_Click"/>
            </Grid>

            <!-- 范围切换 + 分类列表 -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="AllScopeBtn" Margin="18,0,18,4" HorizontalAlignment="Stretch"
                        Click="AllScopeBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="AllScopeIcon" Glyph="&#xE8A9;" FontSize="14"/>
                        <TextBlock x:Name="AllScopeText" Text="全部"/>
                    </StackPanel>
                </Button>

                <ListView x:Name="CategoryList" Grid.Row="1" Margin="10,0,10,8"
                          SelectionChanged="CategoryList_SelectionChanged" Loaded="CategoryList_Loaded"
                          SelectionMode="Single">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection/>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="CatMoveUpBtn_Click" Tag="{Binding}"
                                            IsEnabled="{Binding CanMoveUp}"
                                            Visibility="{Binding ShowSortArrows, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="CatMoveDownBtn_Click" Tag="{Binding}"
                                            IsEnabled="{Binding CanMoveDown}"
                                            Visibility="{Binding ShowSortArrows, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="RenameCatBtn_Click" Tag="{Binding}"
                                            Visibility="{Binding ShowActionButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="DelCatBtn_Click" Tag="{Binding}"
                                            Visibility="{Binding ShowActionButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 排序模式操作栏 -->
            <StackPanel x:Name="SortBar" Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        Margin="18,0,18,10" Visibility="Collapsed">
                <TextBlock Text="正在排序…" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="SortSaveBtn" Content="保存" Style="{StaticResource AccentButtonStyle}"
                        Click="SortSaveBtn_Click"/>
                <Button x:Name="SortCancelBtn" Content="取消" Click="SortCancelBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- 条目视图 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 搜索：按钮 + 向右展开的输入框 -->
                <RowDefinition Height="*"/>      <!-- 条目列表 -->
                <RowDefinition Height="Auto"/>   <!-- 新建条目上滑面板 -->
                <RowDefinition Height="Auto"/>   <!-- 命令栏 -->
            </Grid.RowDefinitions>

            <!-- 搜索 -->
            <Grid Grid.Row="0" Margin="18,14,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SearchToggleBtn" Grid.Column="0" Padding="10,6"
                        Click="SearchToggleBtn_Click">
                    <FontIcon x:Name="SearchIcon" Glyph="&#xE721;" FontSize="14"/>
                </Button>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                Width="0" Opacity="0" Margin="8,0,0,0"
                                PlaceholderText="在当前分类下搜索备注或账号…"
                                TextChanged="SearchBox_TextChanged" QueryIcon="Find"/>
            </Grid>

            <!-- 条目列表 -->
            <ListView x:Name="EntryList" Grid.Row="1" SelectionMode="Single" Margin="10,10,10,0"
                      DoubleTapped="EntryList_DoubleTapped">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection/>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- 条目行 -->
                                <RowDefinition Height="Auto"/>   <!-- 条目下方展开区（下拉式） -->
                            </Grid.RowDefinitions>

                            <!-- 条目行 -->
                            <Grid x:Name="EntryRoot" Grid.Row="0" ColumnSpacing="8"
                                  ColumnDefinitions="Auto,*,*,Auto,Auto">
                                <Border Grid.Column="0" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding CategoryName}" FontSize="11"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Account}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{Binding NoteDisplay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="EntryQueryBtn_Click" Tag="{Binding}"/>
                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="EntryEditBtn_Click" Tag="{Binding}"/>
                                    <Button Content="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="EntryRecoveryBtn_Click" Tag="{Binding}"/>
                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Click="EntryDelBtn_Click" Tag="{Binding}"/>
                                    <Button Content="取消" FontSize="12" Padding="10,4" Visibility="Collapsed"
                                            Click="EntryDelCancelBtn_Click" Tag="{Binding}"/>
                                    <Button Content="确认删除" FontSize="12" Padding="10,4" Visibility="Collapsed"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="EntryDelConfirmBtn_Click" Tag="{Binding}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right">
                                    <Button Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="EntryMoveUpBtn_Click" Tag="{Binding}"
                                            IsEnabled="{Binding CanMoveUp}"/>
                                    <Button Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4"
                                            Click="EntryMoveDownBtn_Click" Tag="{Binding}"
                                            IsEnabled="{Binding CanMoveDown}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 条目下方展开区 -->
                            <Border x:Name="EntryExpand" Grid.Row="1" Visibility="Collapsed"
                                    Margin="0,6,0,2" Padding="12,10"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Background="{ThemeResource LayerFillColorAltBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <StackPanel Spacing="8">
                                    <StackPanel x:Name="EntryDetailPanel" Visibility="Collapsed" Spacing="4"/>
                                    <StackPanel x:Name="EntryRecoveryPanel" Visibility="Collapsed" Spacing="4"/>
                                    <StackPanel x:Name="EntryEditPanel" Visibility="Collapsed" Spacing="6"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed" Spacing="8">
                <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock x:Name="EmptyText" Text="暂无条目" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 右下角新建条目按钮（浮动） -->
            <Button x:Name="FloatingAddBtn" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,20" Padding="14,10" Style="{StaticResource AccentButtonStyle}"
                    Click="AddEntryBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="新建条目"/>
                </StackPanel>
            </Button>

            <!-- 新建条目上滑面板 -->
            <Border x:Name="CreateArea" Grid.Row="2" Visibility="Collapsed"
                    Margin="10,8,10,0" Padding="14,12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CreateAreaTransform" Y="0"/>
                </Border.RenderTransform>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CreateTitle" Text="新建条目" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,8,*,8,*">
                        <TextBox x:Name="NewAccountBox" Grid.Column="0" PlaceholderText="账户名"/>
                        <PasswordBox x:Name="NewPasswordBox" Grid.Column="2" PlaceholderText="密码"/>
                        <TextBox x:Name="NewNoteBox" Grid.Column="4" PlaceholderText="备注（可选）"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="NewCategoryCombo" Width="180"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                                Click="CreateSaveBtn_Click"/>
                        <Button Content="取消" Click="CreateCancelBtn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="CreateErrorText" Visibility="Collapsed" FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
            </Border>

            <!-- 命令栏 -->
            <Grid Grid.Row="3" Padding="18,12" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
