<ContentDialog
    x:Class="KeySecBox.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置"
    PrimaryButtonText="保存"
    CloseButtonText="关闭"
    DefaultButton="Primary">
    <ScrollViewer MaxHeight="520">
        <StackPanel Width="420" Spacing="16" Padding="0,4,16,8">

            <StackPanel Spacing="8">
                <TextBlock Text="外观" FontWeight="SemiBold"/>
                <RadioButtons x:Name="ThemePicker">
                    <x:String>跟随系统</x:String>
                    <x:String>浅色</x:String>
                    <x:String>深色</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="对话框外观" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="圆角" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DialogCornerHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="DialogCornerSlider" Maximum="32" Minimum="0" StepFrequency="1"
                        ValueChanged="OnDialogCornerChanged"/>
                <TextBlock Text="圆角 0 为直角。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="动画帧率" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FrameRateHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="FrameRateSlider" Minimum="1" Maximum="60" StepFrequency="1"
                        ValueChanged="OnFrameRateChanged"/>
                <TextBlock Text="控制列表排序/切换动画的渲染帧率。最低为 1，最高为显示器刷新率。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="安全" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ChangePwdBtn" Content="修改保险库密码…" Click="ChangePwdBtn_Click"/>
                    <Button Content="忘记密码恢复方式…" Click="RecoveryCfgBtn_Click"/>
                    <Button Content="忘记密码？" Click="ForgotPwdBtn_Click"/>
                </StackPanel>
                <TextBlock Text="忘记密码恢复方式，忘记主密码时借此取回。" 
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="数据" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="导入 CSV…" Click="ImportBtn_Click"/>
                    <Button Content="导出 CSV…" Click="ExportBtn_Click"/>
                    <Button x:Name="ImportOldDataBtn" Content="导入旧版库 (1.0.x)…"
                            Click="ImportOldDataBtn_Click"/>
                </StackPanel>
                <TextBlock Text="导出 CSV 列顺序：账户,密码,备注。&#10;导入可指定目标分类；导出内容为明文。&#10;当前支持以下程序导出的 CSV：&#10;1、KeySecBox&#10;2、Microsoft Edge&#10;导入旧版库：选择旧版的 data 目录，将其中数据合并进当前新版库。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="诊断" FontWeight="SemiBold"/>
                <ToggleSwitch x:Name="DiagToggle" Header="诊断模式"
                              OnContent="已开启" OffContent="已关闭"/>
                <TextBlock Text="开启后将写诊断跟踪日志至 trace.log 及 vault.diag.log"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>

            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>