<Window
    x:Class="KeySecBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="KeySecBox">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧：分类导航 ============ -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="18,16,18,10">
                <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="White"/>
                </Border>
                <TextBlock Text="KeySecBox" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 新建分类 -->
            <Button Grid.Row="1" x:Name="AddCatBtn" Content="＋ 新建分类" Margin="18,0,18,8"
                    HorizontalAlignment="Stretch" Click="AddCatBtn_Click" ToolTipService.ToolTip="新增分类"/>

            <!-- 范围切换：全部（常驻，不随分类增删出现/消失） -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="AllScopeBtn" Margin="18,0,18,4" HorizontalAlignment="Stretch"
                        Click="AllScopeBtn_Click" ToolTipService.ToolTip="查看全部条目">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="AllScopeIcon" Glyph="&#xE8A9;" FontSize="14"/>
                        <TextBlock x:Name="AllScopeText" Text="全部"/>
                    </StackPanel>
                </Button>

                <!-- 真实分类列表 -->
                <ListView x:Name="CategoryList" Grid.Row="1" Margin="10,0,10,8"
                          SelectionChanged="CategoryList_SelectionChanged" Loaded="CategoryList_Loaded"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Content="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4" ToolTipService.ToolTip="重命名"
                                            Click="RenameCatBtn_Click" Tag="{Binding}"
                                            Visibility="{Binding Id, Converter={StaticResource CategoryActionVisibilityConverter}}"/>
                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Padding="8,4" ToolTipService.ToolTip="删除"
                                            Click="DelCatBtn_Click" Tag="{Binding}"
                                            Visibility="{Binding Id, Converter={StaticResource CategoryActionVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 设置 -->
            <Button Grid.Row="3" x:Name="SettingsBtn" Margin="18,0,18,16" HorizontalAlignment="Stretch"
                    Click="SettingsBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    <TextBlock Text="设置"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============ 右侧：条目视图 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 搜索 + 视图切换 -->
            <Grid Grid.Row="0" Margin="18,14,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="密码保险库" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <AutoSuggestBox Grid.Column="1" x:Name="SearchBox" Width="260" Margin="0,0,0,2"
                                   PlaceholderText="在当前分类下搜索备注或账号…"
                                   TextChanged="SearchBox_TextChanged" QueryIcon="Find"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- 条目列表 -->
            <ListView x:Name="EntryList" Grid.Row="2" SelectionMode="Single" Margin="10,10,10,0"
                      DoubleTapped="EntryList_DoubleTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="EntryRoot" ColumnSpacing="12" ColumnDefinitions="Auto,*,*,Auto">
                            <!-- 分类 -->
                            <Border Grid.Column="0" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding CategoryName}" FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- 账号 -->
                            <TextBlock Grid.Column="1" Text="{Binding Account}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontSize="14"/>
                            <!-- 备注 -->
                            <TextBlock Grid.Column="2" Text="{Binding NoteDisplay}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <!-- 操作：查看 → 编辑 → 恢复密钥 → 复制 → 删除 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                        Padding="10,5" ToolTipService.ToolTip="查看详情"
                                        Click="EntryQueryBtn_Click" Tag="{Binding}"/>
                                <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                        Padding="10,5" ToolTipService.ToolTip="编辑条目"
                                        Click="EntryEditBtn_Click" Tag="{Binding}"/>
                                <Button Content="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                        Padding="10,5" ToolTipService.ToolTip="恢复密钥"
                                        Click="EntryRecoveryBtn_Click" Tag="{Binding}"/>
                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                        Padding="10,5" ToolTipService.ToolTip="删除条目"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Click="EntryDelBtn_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed" Spacing="8">
                <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock x:Name="EmptyText" Text="暂无条目" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 命令栏 -->
            <Grid Grid.Row="3" Padding="18,12" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddEntryBtn" Content="＋ 新增条目" Style="{StaticResource AccentButtonStyle}"
                            Click="AddEntryBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
