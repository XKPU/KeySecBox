<Window
    x:Class="KeySecBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="KeySecBox">

    <!-- 说明：WinUI 3 的 Window 不是 FrameworkElement，没有 Resources 属性，
         故样式定义在标题栏 Grid 上（见 TitleBar.Resources）。 -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- 标题栏（兼导航栏，内容扩展到标题栏并由其承载拖动） -->
            <RowDefinition Height="Auto"/>
            <!-- 页面内容 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 + 导航（居中） ============ -->
        <!-- 高度由代码同步，仅设下限。窗口控制按钮一律使用系统绘制，
             故此栏不含自绘的最小化/最大化/关闭按钮。 -->
        <Grid x:Name="TitleBar" Grid.Row="0" MinHeight="32"
              Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 拖动区：仅背景层，位于品牌与导航之下 -->
            <Grid x:Name="DragRegion" Grid.ColumnSpan="3" Background="Transparent"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  PointerPressed="DragRegion_PointerPressed"/>

            <!-- 左：品牌 -->
            <StackPanel x:Name="BrandPanel" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        Margin="14,0,8,0" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="5"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="White"/>
                </Border>
                <TextBlock Text="KeySecBox" FontSize="13" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 中：导航（居中） -->
            <StackPanel Grid.Column="1" x:Name="NavList" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="NavVaultBtn" Tag="Vault" Padding="12,3"
                        Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D1;" FontSize="14"/>
                        <TextBlock Text="库"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NavTransferBtn" Tag="Transfer" Padding="12,3"
                        Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14"/>
                        <TextBlock Text="导入/导出"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NavSettingsBtn" Tag="Settings" Padding="12,3"
                        Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock Text="设置"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 右：留白。窗口控制按钮由系统绘制（已用主题配色融入风格），
                 故不放置自绘按钮，避免与其重叠。 -->
            <Border Grid.Column="2" Width="140" Background="Transparent"/>
        </Grid>

        <!-- ============ 页面内容 ============ -->
        <Frame x:Name="ContentFrame" Grid.Row="1"/>

        <!-- ============ 解锁覆盖层：只覆盖内容区，标题栏保持可见（但隐藏页面切换按钮） ============ -->
        <Grid x:Name="UnlockOverlay" Grid.Row="1"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="Collapsed">
            <!-- 裁剪到内容区，避免上滑时盖住标题栏；初始 Rect 不可为空 -->
            <Grid.Clip>
                <RectangleGeometry x:Name="UnlockOverlayClip" Rect="0,0,100000,100000"/>
            </Grid.Clip>
            <!-- 外层：解锁面板整体上滑离场用 -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="OverlayTransform" Y="0"/>
            </Grid.RenderTransform>

            <!-- 内层：两页横向滑动容器。页 0 = 主密码，页 1 = 恢复方式（建库后左滑进入）。
                 两页各占满一屏宽（宽度绑定 UnlockOverlay），整体左移一屏即从页 0 切到页 1。
                 这里不设 Clip：外层 UnlockOverlay 的 Clip 已把范围裁到内容区，
                 即"视口"；若在此处再裁到一屏宽，会连同已滑入的页一起裁掉。
                 （另注：Grid 没有 ClipToBounds 属性，那是 WPF 的，WinUI 3 会编译失败。） -->
            <Grid x:Name="UnlockSlides" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SlideTransform" X="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 页 0：主密码（首次建库 / 常规解锁共用）。
                     宽度由代码按覆盖层实际宽度设置（见 UpdateUnlockClip），
                     不用 Binding：布局阶段 ActualWidth 可能还是 0，会把整页压成 0 宽。 -->
                <Grid x:Name="UnlockPage" Grid.Column="0">
                    <StackPanel x:Name="UnlockPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="340" Spacing="14" Padding="24">
                    <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE72E;" FontSize="26" Foreground="White"/>
                    </Border>

                    <TextBlock x:Name="UnlockHeadline" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Text="欢迎回来"/>
                    <TextBlock x:Name="UnlockSubText" FontSize="13" TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="请输入主密码以解锁保险库。"/>

                    <PasswordBox x:Name="UnlockPasswordBox" PlaceholderText="主密码"
                                 PasswordChanged="UnlockPasswordBox_PasswordChanged">
                        <PasswordBox.RenderTransform>
                            <TranslateTransform x:Name="PasswordBoxTransform" X="0"/>
                        </PasswordBox.RenderTransform>
                    </PasswordBox>

                    <PasswordBox x:Name="UnlockConfirmBox" PlaceholderText="再次输入主密码"
                                 PasswordChanged="UnlockPasswordBox_PasswordChanged">
                        <PasswordBox.RenderTransform>
                            <TranslateTransform x:Name="ConfirmBoxTransform" X="0"/>
                        </PasswordBox.RenderTransform>
                    </PasswordBox>

                    <Button x:Name="UnlockButton" Content="解锁" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                            Click="UnlockButton_Click"/>

                    <HyperlinkButton x:Name="UnlockForgotLink" Content="忘记密码？"
                                     HorizontalAlignment="Center" Visibility="Collapsed"
                                     Click="UnlockForgotLink_Click"/>

                    <ProgressBar x:Name="UnlockProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                    <TextBlock x:Name="UnlockErrorText" FontSize="12" TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 页 1：恢复方式设置（内联，不再弹对话框）。宽度同样由代码设置。 -->
                <Grid x:Name="RecoveryPage" Grid.Column="1">
                    <StackPanel x:Name="RecoveryPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="400" Spacing="12" Padding="24">
                    <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE8F4;" FontSize="26" Foreground="White"/>
                    </Border>

                    <TextBlock x:Name="RecoveryHeadline" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Text="忘记密码怎么办？"/>
                    <TextBlock x:Name="RecoveryIntroText" FontSize="13" TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="建议配置一种恢复方式。忘记主密码时，可用以下方式取回保险库访问权。"/>

                    <CheckBox x:Name="RecoveryBackupCheck" Content="备用密码"
                              Checked="RecoveryMethod_Toggled" Unchecked="RecoveryMethod_Toggled"/>
                    <StackPanel x:Name="RecoveryBackupPanel" Spacing="8" Margin="24,0,0,0"
                                Visibility="Collapsed">
                        <PasswordBox x:Name="RecoveryBackupPwdBox" PlaceholderText="请输入备用密码"/>
                        <PasswordBox x:Name="RecoveryBackupConfirmBox" PlaceholderText="再次输入备用密码"/>
                        <TextBlock Text="备用密码用于忘记主密码时取回保险库，需与主密码不同。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <CheckBox x:Name="RecoverySystemCheck" Content="Windows Hello"
                              Checked="RecoveryMethod_Toggled" Unchecked="RecoveryMethod_Toggled"/>
                    <TextBlock Margin="24,0,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="使用当前 Windows 账户保护恢复副本。保存时需完成一次系统验证，将本程序纳入 Windows Hello 支持。"/>

                    <TextBlock x:Name="RecoveryErrorText" FontSize="12" TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>

                    <Button x:Name="RecoverySaveBtn" Content="保存恢复方式" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RecoverySaveBtn_Click"/>
                    <HyperlinkButton Content="暂不设置，直接进入" HorizontalAlignment="Center"
                                     Click="RecoverySkipBtn_Click"/>
                    <ProgressBar x:Name="RecoveryProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
