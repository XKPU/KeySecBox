<ContentDialog
    x:Class="KeySecBox.HiddenFilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="隐藏文件"
    CloseButtonText="关闭"
    DefaultButton="Close">
    <StackPanel Width="520" Spacing="12">

        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="用「隐藏 + 系统 + 只读」属性把文件或文件夹从资源管理器中隐去（等价 attrib +s +h +r），恢复时清除这三项属性。记录本身保存在加密的保险库中，路径不会明文落盘。"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddFileBtn" Content="＋ 添加文件…" Click="AddFileBtn_Click"/>
            <Button x:Name="AddFolderBtn" Content="＋ 添加文件夹…" Click="AddFolderBtn_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <TextBlock x:Name="EmptyText" Text="还没有隐藏任何文件或文件夹。"
                   FontSize="13" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <ListView x:Name="ItemList" MaxHeight="380" SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection/>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="12"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                        Background="{ThemeResource LayerFillColorAltBrush}">
                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding FullPath}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Content="{Binding ToggleText}" Tag="{Binding}" Padding="8,4"
                                    Click="ToggleBtn_Click"/>
                            <Button Content="重命名" Tag="{Binding}" Padding="8,4"
                                    Click="RenameBtn_Click"/>
                            <Button Content="密码" Tag="{Binding}" Padding="8,4"
                                    Click="PasswordBtn_Click"/>
                            <Button Content="移除" Tag="{Binding}" Padding="8,4"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Click="RemoveBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
