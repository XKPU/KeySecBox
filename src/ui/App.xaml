<Application
    x:Class="KeySecBox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeySecBox">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

<ResourceDictionary.ThemeDictionaries>
        <!-- 选中/激活态配色 -->
        <ResourceDictionary x:Key="Light">
            <CornerRadius x:Key="OverlayCornerRadius">12,12,12,12</CornerRadius>
            <SolidColorBrush x:Key="ScopeActiveBrush" Color="#EADDFF"/>
            <SolidColorBrush x:Key="ScopeActiveForegroundBrush" Color="#21005D"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#EADDFF"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#21005D"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#E4D5FF"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#21005D"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#D9C6FF"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#21005D"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <CornerRadius x:Key="OverlayCornerRadius">12,12,12,12</CornerRadius>
            <SolidColorBrush x:Key="ScopeActiveBrush" Color="#4F378B"/>
            <SolidColorBrush x:Key="ScopeActiveForegroundBrush" Color="#EADDFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#4F378B"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#EADDFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#59469D"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#EADDFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#6450A6"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#EADDFF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <local:CategoryActionVisibilityConverter x:Key="CategoryActionVisibilityConverter"/>
</ResourceDictionary>
    </Application.Resources>
</Application>
