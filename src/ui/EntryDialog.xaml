<ContentDialog
    x:Class="KeySecBox.EntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="条目"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <StackPanel Width="360" Spacing="10">
        <StackPanel Spacing="4">
            <TextBlock Text="分类（可选）"/>
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                      PlaceholderText="未选择分类"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewCatBox" PlaceholderText="新建分类"
                         KeyDown="NewCatBox_KeyDown"/>
                <Button Grid.Column="1" Content="新建分类" Click="NewCatBtn_Click" Padding="12,5"/>
            </Grid>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="账户名"/>
            <TextBox x:Name="AccountBox"/>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="密码"/>
            <PasswordBox x:Name="PasswordBox" PlaceholderText="支持无账号密码不填写"/>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="备注"/>
            <TextBox x:Name="NoteBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" PlaceholderText="可选"/>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="恢复密钥"/>
            <TextBox x:Name="RecoveryBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                     PlaceholderText="每行一个，可留空，之后可在恢复密钥对话框中管理"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>