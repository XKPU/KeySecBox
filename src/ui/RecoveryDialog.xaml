<ContentDialog
    x:Class="KeySecBox.RecoveryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="恢复密钥"
    CloseButtonText="关闭"
    DefaultButton="Close">
    <StackPanel Width="420" Spacing="12">
        <TextBlock x:Name="SubText" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ListView x:Name="KeyList" SelectionMode="None" MinHeight="120" MaxHeight="280">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding}" IsTextSelectionEnabled="False"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="复制" Click="CopyKey_Click" Tag="{Binding}"
                                Padding="8,3"/>
                        <Button Grid.Column="2" Content="删除" Click="DeleteKey_Click" Tag="{Binding}"
                                Padding="8,3"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Spacing="4">
            <TextBlock Text="添加一把恢复密钥"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="NewKeyBox" PlaceholderText="粘贴或输入一把恢复密钥，回车添加"/>
                <Button Grid.Column="1" Content="添加" Click="AddKey_Click" Padding="12,4"/>
            </Grid>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>