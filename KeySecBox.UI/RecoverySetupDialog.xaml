<ContentDialog
    x:Class="KeySecBox.RecoverySetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="忘记密码怎么办？"
    PrimaryButtonText="保存恢复方式"
    CloseButtonText="暂不设置"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Loaded="ContentDialog_Loaded">

    <StackPanel Width="400" Spacing="12">
        <TextBlock x:Name="IntroText"
                   Text="建议配置一种恢复方式。忘记主密码时，可用以下方式取回加密库访问权、。"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

        <StackPanel x:Name="MasterVerifyPanel" Spacing="6">
            <TextBlock Text="验证主密码" FontWeight="SemiBold"/>
            <PasswordBox x:Name="MasterVerifyBox" PlaceholderText="请输入当前主密码"/>
        </StackPanel>

        <CheckBox x:Name="BackupCheck" Content="备用密码" Checked="OnMethodToggled" Unchecked="OnMethodToggled"/>
        <StackPanel x:Name="BackupPanel" Spacing="8" Visibility="Collapsed" Margin="24,0,0,0">
            <PasswordBox x:Name="BackupPwdBox" PlaceholderText="请输入备用密码"/>
            <PasswordBox x:Name="BackupConfirmBox" PlaceholderText="再次输入备用密码"/>
            <TextBlock Text="备用密码用于忘记主密码时取回保险库，需与主密码不同。" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <CheckBox x:Name="SystemCheck" Content="Windows Hello" Checked="OnMethodToggled" Unchecked="OnMethodToggled"/>
        <TextBlock x:Name="SystemHint" Margin="24,0,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="使用当前 Windows 账户保护恢复副本。保存时需完成一次系统验证，将本程序纳入 Windows Hello 支持。"/>

        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>