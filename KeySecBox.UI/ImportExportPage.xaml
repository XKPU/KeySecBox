<Page
    x:Class="KeySecBox.ImportExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" Margin="28,24,28,28" Spacing="20">

            <TextBlock x:Name="StatusText" Visibility="Collapsed" TextWrapping="Wrap"/>

            <StackPanel Spacing="8">
                <TextBlock Text="导入" FontWeight="SemiBold"/>
                <Button Content="导入 …" Click="ImportBtn_Click" HorizontalAlignment="Left"
                        Style="{StaticResource AccentButtonStyle}"/>
                <TextBlock Text="支持 CSV（.csv / .csvenc）与 JSON（.json）高级导入：可指定字段键名并预览原始内容；也可导入旧版库 1.0.x。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="导出" FontWeight="SemiBold"/>
                <Button Content="导出 …" Click="ExportBtn_Click" HorizontalAlignment="Left"/>
                <TextBlock Text="导出字段顺序：分类，账户，密码，备注，恢复密钥。可选 CSV、已加密的 CSV、完整数据目录、已加密的完整数据目录。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
