<Page
    x:Class="KeySecBox.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" Margin="28,24,28,28" Spacing="20">

            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" TextWrapping="Wrap"/>

            <StackPanel Spacing="8">
                <TextBlock Text="外观" FontWeight="SemiBold"/>
                <RadioButtons x:Name="ThemePicker" SelectionChanged="OnThemeChanged">
                    <x:String>跟随系统</x:String>
                    <x:String>浅色</x:String>
                    <x:String>深色</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="对话框外观" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="圆角" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DialogCornerHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="DialogCornerSlider" Maximum="32" Minimum="0" StepFrequency="1"
                        ValueChanged="OnDialogCornerChanged"/>
                <TextBlock Text="圆角 0 为直角。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="动画帧率" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FrameRateHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="FrameRateSlider" Minimum="1" Maximum="60" StepFrequency="1"
                        ValueChanged="OnFrameRateChanged"/>
                <TextBlock Text="控制列表排序/切换动画的渲染帧率。最低为 1，最高为显示器刷新率。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="安全" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ChangePwdBtn" Content="修改保险库密码…" Click="ChangePwdBtn_Click"/>
                    <Button Content="忘记密码恢复方式…" Click="RecoveryCfgBtn_Click"/>
                    <Button Content="忘记密码？" Click="ForgotPwdBtn_Click"/>
                </StackPanel>
                <TextBlock Text="忘记密码恢复方式，忘记主密码时借此取回。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="诊断" FontWeight="SemiBold"/>
                <ToggleSwitch x:Name="DiagToggle" Header="诊断模式" Toggled="OnDiagToggled"
                              OnContent="已开启" OffContent="已关闭"/>
                <TextBlock Text="开启后将写诊断跟踪日志至 trace.log 及 vault.diag.log"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</Page>
