<ContentDialog
    x:Class="KeySecBox.CsvExportOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeySecBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable=""
    Title="CSV 导出选项"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Width="420" Spacing="14">
        <TextBlock Text="选择要导出的分类（不选则导出全部）：" TextWrapping="Wrap"
                   FontWeight="SemiBold"/>
        <ListView x:Name="CategoryList" SelectionMode="Multiple"
                  MaxHeight="200"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CategoryItem">
                    <TextBlock Text="{x:Bind Name}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <CheckBox x:Name="IncludeCategoryBox"
                  Content="在导出文件中保留分类字段"
                  Checked="IncludeCategoryBox_Changed"
                  Unchecked="IncludeCategoryBox_Changed"/>

        <TextBlock Text="自定义字段名称（留空则使用默认英文）：" TextWrapping="Wrap"
                   FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="12" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="分类" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CategoryHeader"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="账户" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccountHeader"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="密码" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PasswordHeader"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="备注" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="NoteHeader"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="恢复密钥" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="RecoveryHeader"/>
        </Grid>
        <TextBlock Text="分类与恢复密钥含多个值时用 &amp;n 分隔（前后各一个空格）。"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</ContentDialog>
