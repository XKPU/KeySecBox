<ContentDialog
    x:Class="KeySecBox.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="修改保险库密码"
    PrimaryButtonText="确认修改"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <StackPanel Width="340" Spacing="10">
        <TextBlock Text="旧密码" TextWrapping="Wrap"/>
        <PasswordBox x:Name="OldBox" PasswordChanged="OnChanged" IsPasswordRevealButtonEnabled="False"
                     KeyDown="PasswordKeyDown" ContextRequested="PasswordContextRequested"/>
        <HyperlinkButton x:Name="ForgotPwdLink" Content="忘记密码？" Click="ForgotPwdLink_Click"
                         Visibility="Collapsed" HorizontalAlignment="Left"/>
        <TextBlock Text="新密码" TextWrapping="Wrap"/>
        <PasswordBox x:Name="NewBox" PasswordChanged="OnChanged" IsPasswordRevealButtonEnabled="False"
                     KeyDown="PasswordKeyDown" ContextRequested="PasswordContextRequested"/>
        <TextBlock Text="确认新密码" TextWrapping="Wrap"/>
        <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnChanged" IsPasswordRevealButtonEnabled="False"
                     KeyDown="PasswordKeyDown" ContextRequested="PasswordContextRequested"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap"/>
        <ProgressRing x:Name="Busy" IsActive="False" Height="24" Width="24" HorizontalAlignment="Left"/>
    </StackPanel>
</ContentDialog>
