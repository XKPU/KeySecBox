<ContentDialog
    x:Class="KeySecBox.ForgotPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="忘记主密码"
    CloseButtonText="取消"
    DefaultButton="None"
    Loaded="ContentDialog_Loaded">

    <StackPanel Width="400" Spacing="12">
        <TextBlock Text="取回主密码"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

        <StackPanel x:Name="BackupPanel" Spacing="8">
            <TextBlock Text="用备用密码取回" FontWeight="SemiBold"/>
            <PasswordBox x:Name="BackupPwdBox" PlaceholderText="请输入备用密码" KeyDown="BackupPwdBox_KeyDown"
                     IsPasswordRevealButtonEnabled="False" ContextRequested="BackupContextRequested"/>
            <Button Content="取回" Click="BackupRecover_Click" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel x:Name="SystemPanel" Spacing="8">
            <TextBlock Text="使用系统解锁（PIN / 指纹 / 人脸）" FontWeight="SemiBold"/>
            <TextBlock Text="将调用 Windows Hello 系统验证确认您的身份。" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <Button Content="使用 Windows Hello 取回" Click="SystemRecover_Click" HorizontalAlignment="Left"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>