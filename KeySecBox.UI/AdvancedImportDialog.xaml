<ContentDialog
    x:Class="KeySecBox.AdvancedImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="高级导入"
    PrimaryButtonText="导入"
    CloseButtonText="取消"
    MinWidth="1200"
    MaxWidth="2400"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <Grid ColumnDefinitions="*,1.35*" ColumnSpacing="20">
        <!-- 左：字段映射输入 -->
        <ScrollViewer Grid.Column="0" MaxHeight="620" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,8,0">
                <TextBlock Text="字段映射：键名请用 ${} 包裹，例如 ${account}；支持多层路径与通配符，例如 ${1/:*/:2}"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock x:Name="AutoFillHint"
                           Text="已识别为本程序标准格式，已自动填入字段，可修改。"
                           TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                <TextBlock x:Name="HeadersHint" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Text="分类（可填键名，或选择/新建固定分类；都为空则未分类）"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBox x:Name="CategoryKeyBox" PlaceholderText="${category}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="CategoryCombo" Width="170"
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    <TextBox x:Name="NewCatBox" Width="120" PlaceholderText="新分类名"/>
                    <Button Content="新建" Click="NewCatBtn_Click"/>
                </StackPanel>

                <TextBlock Text="账号名称（必填键名）" Margin="0,6,0,0"/>
                <TextBox x:Name="AccountKeyBox" PlaceholderText="${account}"/>

                <TextBlock Text="账户密码（必填键名）" Margin="0,6,0,0"/>
                <TextBox x:Name="PasswordKeyBox" PlaceholderText="${password}"/>

                <TextBlock Text="备注（可选，多个键名可多行填入）" Margin="0,6,0,0"/>
                <TextBox x:Name="NoteKeysBox" AcceptsReturn="True" Height="90"
                         PlaceholderText="${note}（每行一个）"/>

                <TextBlock Text="恢复密钥（可选，多个键名可多行填入）" Margin="0,6,0,0"/>
                <TextBox x:Name="RecoveryKeysBox" AcceptsReturn="True" Height="90"
                         PlaceholderText="${recovery} 或 ${1/:*/:2}（每行一个）"/>

                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 右：原始内容 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock Text="原始内容（可选中复制）" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" x:Name="RawContent"
                     IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" Height="620"
                     FontFamily="Consolas" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </Grid>
</ContentDialog>
