<Window x:Class="KeySecBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KeySecBox"
        Width="1080" Height="700"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- ================= WPF 标题栏方案 =================
         用 WindowChrome 自绘标题栏：CaptionHeight 指定可拖动高度，
         交互控件用 WindowChrome.IsHitTestVisibleInChrome="True" 声明。
         这是 WPF 内建机制，**不存在** WinUI 3 那种「整条标题栏被系统吞掉点击、
         必须手算直通矩形」的问题 —— 原先 233 行补丁代码在这里直接消失。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 标题栏（兼导航栏） -->
            <RowDefinition Height="48"/>
            <!-- 页面内容 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 + 导航 ============ -->
        <Grid x:Name="TitleBar" Grid.Row="0"
              Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 品牌 + 导航：整体居中。按钮声明为 Chrome 内可命中，能正常点击；
                 空白处落在 CaptionHeight 内即可拖动窗口。 -->
            <StackPanel x:Name="TitleBarContent" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="BrandPanel" Orientation="Horizontal"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KeySecBox" FontSize="13" VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel x:Name="NavList" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavVaultBtn" Tag="Vault" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="库" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavTransferBtn" Tag="Transfer" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="导入/导出" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettingsBtn" Tag="Settings" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="设置" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 右侧：自绘窗口控制按钮（WPF 下由我们负责） -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Click="MinBtn_Click" Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="最小化">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="MaxBtn" Click="MaxBtn_Click" Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="最大化">
                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="CloseBtn" Click="CloseBtn_Click" Style="{StaticResource CloseButtonStyle}"
                        ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 页面内容 ============ -->
        <ContentControl x:Name="ContentHost" Grid.Row="1"/>

        <!-- ============ 解锁覆盖层：只覆盖内容区，标题栏保持可见 ============ -->
        <Grid x:Name="UnlockOverlay" Grid.Row="1"
              Background="{DynamicResource AppBackgroundBrush}"
              Visibility="Collapsed"
              ClipToBounds="True">
            <!-- 外层：解锁面板整体上滑离场用 -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="OverlayTransform" Y="0"/>
            </Grid.RenderTransform>

            <!-- 内层：两页横向滑动容器。页 0 = 主密码，页 1 = 恢复方式。
                 WPF 有 ClipToBounds，外层已裁到内容区即"视口"，
                 这里不再裁剪，否则会把已滑入的页一起裁掉。 -->
            <Grid x:Name="UnlockSlides" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SlideTransform" X="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 页 0：主密码（首次建库 / 常规解锁共用） -->
                <Grid x:Name="UnlockPage" Grid.Column="0">
                    <StackPanel x:Name="UnlockPanel" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Width="340">
                        <Border Width="56" Height="56" CornerRadius="14"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="UnlockHeadline" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Text="欢迎回来"
                                   Margin="0,14,0,0"/>
                        <TextBlock x:Name="UnlockSubText" FontSize="13" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="请输入主密码以解锁保险库。"/>

                        <!-- 密码区整体加 TranslateTransform：错误时抖动 -->
                        <StackPanel x:Name="PasswordBoxPanel" Margin="0,14,0,0">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PasswordBoxTransform" X="0"/>
                            </StackPanel.RenderTransform>
                            <PasswordBox x:Name="UnlockPasswordBox"
                                         PasswordChanged="UnlockPasswordBox_PasswordChanged"/>
                            <PasswordBox x:Name="UnlockConfirmBox" Margin="0,8,0,0"
                                         PasswordChanged="UnlockPasswordBox_PasswordChanged"/>
                        </StackPanel>

                        <Button x:Name="UnlockButton" Content="解锁" Margin="0,14,0,0"
                                HorizontalAlignment="Stretch" Height="34"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False" Click="UnlockButton_Click"/>

                        <Button x:Name="UnlockForgotLink" Content="忘记密码？" Style="{StaticResource LinkButtonStyle}"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Center" Visibility="Collapsed"
                                         Click="UnlockForgotLink_Click"/>

                        <ProgressBar x:Name="UnlockProgress" IsIndeterminate="True"
                                     Margin="0,10,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="UnlockErrorText" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource ErrorBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 页 1：恢复方式设置（内联，不弹对话框） -->
                <Grid x:Name="RecoveryPage" Grid.Column="1">
                    <StackPanel x:Name="RecoveryPanel" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Width="400">
                        <Border Width="56" Height="56" CornerRadius="14"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="RecoveryHeadline" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Text="忘记密码怎么办？"
                                   Margin="0,14,0,0"/>
                        <TextBlock x:Name="RecoveryIntroText" FontSize="13" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="建议配置一种恢复方式。忘记主密码时，可用以下方式取回保险库访问权。"/>

                        <CheckBox x:Name="RecoveryBackupCheck" Content="备用密码" Margin="0,12,0,0"
                                  HorizontalAlignment="Left"
                                  Checked="RecoveryMethod_Toggled" Unchecked="RecoveryMethod_Toggled"/>
                        <StackPanel x:Name="RecoveryBackupPanel" Margin="24,8,0,0"
                                    Visibility="Collapsed">
                            <PasswordBox x:Name="RecoveryBackupPwdBox"/>
                            <PasswordBox x:Name="RecoveryBackupConfirmBox" Margin="0,8,0,0"/>
                            <TextBlock Text="备用密码用于忘记主密码时取回保险库，需与主密码不同。"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox x:Name="RecoverySystemCheck" Content="Windows Hello" Margin="0,12,0,0"
                                  HorizontalAlignment="Left"
                                  Checked="RecoveryMethod_Toggled" Unchecked="RecoveryMethod_Toggled"/>
                        <TextBlock Margin="24,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="使用当前 Windows 账户保护恢复副本。保存时需完成一次系统验证。"/>

                        <TextBlock x:Name="RecoveryErrorText" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource ErrorBrush}"/>

                        <Button x:Name="RecoverySaveBtn" Content="保存恢复方式" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" Height="34"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="RecoverySaveBtn_Click"/>
                        <Button Content="暂不设置，直接进入" Margin="0,8,0,0" Style="{StaticResource LinkButtonStyle}"
                                         HorizontalAlignment="Center"
                                         Click="RecoverySkipBtn_Click"/>
                        <ProgressBar x:Name="RecoveryProgress" IsIndeterminate="True"
                                     Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
