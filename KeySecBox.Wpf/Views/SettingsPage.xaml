<UserControl x:Class="KeySecBox.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" Margin="28,24,28,28">

            <TextBlock x:Name="StatusText" Margin="0,0,0,16" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed"/>

            <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel x:Name="ThemePicker" Margin="0,0,0,10">
                <RadioButton x:Name="ThemeSystem" Content="跟随系统" GroupName="Theme"
                             Margin="0,2" Checked="OnThemeChanged"/>
                <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="Theme"
                             Margin="0,2" Checked="OnThemeChanged"/>
                <RadioButton x:Name="ThemeDark" Content="深色" GroupName="Theme"
                             Margin="0,2" Checked="OnThemeChanged"/>
            </StackPanel>

            <TextBlock Text="对话框外观" FontWeight="SemiBold" Margin="0,10,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="圆角" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="DialogCornerHint" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Slider x:Name="DialogCornerSlider" Maximum="32" Minimum="0"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="OnDialogCornerChanged"/>
            <TextBlock Text="圆角 0 为直角。" TextWrapping="Wrap" FontSize="12"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                <TextBlock Text="动画帧率" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="FrameRateHint" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Slider x:Name="FrameRateSlider" Minimum="1" Maximum="60"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="OnFrameRateChanged"/>
            <TextBlock Text="控制列表排序/切换动画的渲染帧率。最低为 1，最高为显示器刷新率。"
                       TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="安全" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ChangePwdBtn" Content="修改保险库密码…" Padding="14,6"
                        Click="ChangePwdBtn_Click"/>
                <Button Content="忘记密码恢复方式…" Margin="8,0,0,0" Padding="14,6"
                        Click="RecoveryCfgBtn_Click"/>
                <Button Content="忘记密码？" Margin="8,0,0,0" Padding="14,6"
                        Click="ForgotPwdBtn_Click"/>
            </StackPanel>
            <TextBlock Text="忘记密码恢复方式，忘记主密码时借此取回。"
                       TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="诊断" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <CheckBox x:Name="DiagToggle" Content="诊断模式"
                      Checked="OnDiagToggled" Unchecked="OnDiagToggled"/>
            <TextBlock Text="开启后将写诊断跟踪日志至 trace.log 及 vault.diag.log"
                       TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,20,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
