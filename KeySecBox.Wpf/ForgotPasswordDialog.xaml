<local:ContentDialogBase x:Class="KeySecBox.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:KeySecBox"
        Title="忘记主密码">
    <Border Background="#66000000" Padding="24">
        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                CornerRadius="8" Padding="20" Width="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="忘记主密码" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="取回主密码" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <StackPanel x:Name="BackupPanel" Margin="0,14,0,0">
                    <TextBlock Text="用备用密码取回" FontWeight="SemiBold" FontSize="13"/>
                    <ui:PasswordBox x:Name="BackupPwdBox" Margin="0,8,0,0"
                                 KeyDown="BackupPwdBox_KeyDown"
                                 ContextMenu="{x:Null}"/>
                    <Button x:Name="RecoverBtn" Content="取回" Margin="0,10,0,0"
                            HorizontalAlignment="Left" MinWidth="88" Height="32"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="BackupRecover_Click"/>
                </StackPanel>

                <StackPanel x:Name="SystemPanel" Margin="0,16,0,0">
                    <TextBlock Text="使用系统解锁（PIN / 指纹 / 人脸）" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="将调用 Windows Hello 系统验证确认您的身份。"
                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button Content="使用 Windows Hello 取回" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Height="32" Padding="14,0"
                            Click="SystemRecover_Click"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>

                <Button x:Name="CancelBtn" Content="取消" Margin="0,18,0,0"
                        MinWidth="88" Height="32" HorizontalAlignment="Right"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Border>
</local:ContentDialogBase>
