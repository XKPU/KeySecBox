<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 配色（浅色默认） ================= -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#20000000"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>

    </ResourceDictionary>
