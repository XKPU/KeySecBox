<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 配色（深色） ================= -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>

</ResourceDictionary>
