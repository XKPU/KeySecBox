<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ================= 应用语义别名（仅供本项目 XAML 使用） =================
         WinUI 3 里 TextFillColorSecondaryBrush / CardStrokeColorDefaultBrush 等
         Fluent 令牌由框架自带；WPF 没有，改由 WPF-UI 提供，页面直接引用其原生名。

         本文件只放**本项目自有**的语义名与尺寸，不重复 WPF-UI 的令牌。

         踩坑记录：曾尝试用
             <DynamicResource x:Key="X" ResourceKey="SystemAccentColorBrush"/>
         做别名 —— 能编译通过，但运行期抛
             InvalidOperationException: ResourceReferenceExpression 不是属性 Background 的有效值
         因为该写法产出的是表达式对象而非画刷。资源别名在 WPF 里不可行，
         正确做法是在使用处直接写 WPF-UI 的原生令牌名。 -->

    <!-- 窗口控制按钮（Fluent 规范：悬停浅色、关闭悬停红底白字） -->
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>

    <!-- ================= 尺寸（Fluent 规范） =================
         WPF 默认正文 12px，WinUI 默认 14px —— 这是「观感偏小、偏原始」的主因。
         WinUI 版实测字号分布：12×44（次要文本）、14×7、13×5、20×2、40×1。 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">20</sys:Double>
    <sys:Double x:Key="TitleFontSize">28</sys:Double>
    <sys:Double x:Key="DisplayFontSize">40</sys:Double>

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

</ResourceDictionary>
