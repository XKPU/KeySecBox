<local:ContentDialogBase x:Class="KeySecBox.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeySecBox"
        Title="恢复密钥">
    <Border Background="#66000000" Padding="24">
        <Border Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="8" Padding="20" Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="SubText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <Border Margin="0,12,0,0" MinHeight="120" MaxHeight="280"
                        BorderThickness="1" CornerRadius="4"
                        BorderBrush="{DynamicResource DividerBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="KeyList" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="复制" Margin="8,0,0,0"
                                                Padding="8,3" Tag="{Binding}" Click="CopyKey_Click"/>
                                        <Button Grid.Column="2" Content="删除" Margin="6,0,0,0"
                                                Padding="8,3" Tag="{Binding}" Click="DeleteKey_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="添加一把恢复密钥" Margin="0,14,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewKeyBox" Height="28" VerticalContentAlignment="Center"
                             KeyDown="NewKeyBox_KeyDown"/>
                    <Button Grid.Column="1" Content="添加" Margin="8,0,0,0"
                            Padding="14,4" Click="AddKey_Click"/>
                </Grid>

                <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap"
                           FontSize="12" Visibility="Collapsed"
                           Foreground="{DynamicResource ErrorBrush}"/>

                <Button x:Name="CloseBtn" Content="关闭" MinWidth="88" Height="32"
                        Margin="0,18,0,0" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Border>
</local:ContentDialogBase>
