<local:ContentDialogBase x:Class="KeySecBox.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeySecBox"
        Title="修改保险库密码">
    <Border Background="#66000000" Padding="24">
        <Border Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="8" Padding="20" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="修改保险库密码" FontSize="16" FontWeight="SemiBold"/>

                <TextBlock Text="旧密码" Margin="0,14,0,4"/>
                <PasswordBox x:Name="OldBox" PasswordChanged="OnChanged"
                             KeyDown="PasswordKeyDown" ContextMenu="{x:Null}"/>
                <Button x:Name="ForgotPwdLink" Content="忘记密码？"
                        Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,4,0,0"
                        Visibility="Collapsed" Click="ForgotPwdLink_Click"/>

                <TextBlock Text="新密码" Margin="0,10,0,4"/>
                <PasswordBox x:Name="NewBox" PasswordChanged="OnChanged"
                             KeyDown="PasswordKeyDown" ContextMenu="{x:Null}"/>

                <TextBlock Text="确认新密码" Margin="0,10,0,4"/>
                <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnChanged"
                             KeyDown="PasswordKeyDown" ContextMenu="{x:Null}"/>

                <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap"
                           FontSize="12" Visibility="Collapsed"
                           Foreground="{DynamicResource ErrorBrush}"/>

                <ProgressBar x:Name="Busy" Height="4" Width="120"
                             HorizontalAlignment="Left" Margin="0,10,0,0"
                             Visibility="Collapsed" IsIndeterminate="True"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelBtn" Content="取消" MinWidth="88" Height="32"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="确认修改" MinWidth="88" Height="32"
                            Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</local:ContentDialogBase>
