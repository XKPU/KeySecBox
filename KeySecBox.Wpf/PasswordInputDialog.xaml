<local:ContentDialogBase x:Class="KeySecBox.PasswordInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:KeySecBox"
        Title="输入密码">
    <Border Background="#66000000" Padding="24">
        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                CornerRadius="8" Padding="20" Width="360"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="13"/>

                <ui:PasswordBox x:Name="PasswordBox" Margin="0,12,0,0" ContextMenu="{x:Null}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelBtn" Content="取消" MinWidth="88" Height="32"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="确定" MinWidth="88" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</local:ContentDialogBase>
