<local:ContentDialogBase x:Class="KeySecBox.CsvExportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeySecBox"
        Title="CSV 导出选项">
    <Border Background="#66000000" Padding="24">
        <Border Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="8" Padding="20" Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="CSV 导出选项" FontSize="16" FontWeight="SemiBold"/>

                <TextBlock Text="选择要导出的分类（不选则导出全部）：" TextWrapping="Wrap"
                           FontWeight="SemiBold" Margin="0,14,0,0"/>

                <!-- WinUI ListView SelectionMode=Multiple -> WPF ListView SelectionMode=Extended。
                     原模板用 x:Bind，此处改为 {Binding} -->
                <ListView x:Name="CategoryList" SelectionMode="Extended"
                          MaxHeight="200" Margin="0,8,0,0"
                          BorderBrush="{DynamicResource DividerBrush}"
                          BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <CheckBox x:Name="IncludeCategoryBox"
                          Content="在导出文件中保留分类字段"
                          Margin="0,12,0,0"
                          Checked="IncludeCategoryBox_Changed"
                          Unchecked="IncludeCategoryBox_Changed"/>

                <TextBlock Text="自定义字段名称（留空则使用默认英文）：" TextWrapping="Wrap"
                           FontWeight="SemiBold" Margin="0,14,0,0"/>

                <!-- WinUI Grid 的 ColumnSpacing/RowSpacing 在 WPF 不存在：改用子元素 Margin -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="分类" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="CategoryHeader" Margin="12,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="账户" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccountHeader" Margin="12,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="密码" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PasswordHeader" Margin="12,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="备注" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="NoteHeader" Margin="12,0,0,8"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="恢复密钥" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="RecoveryHeader" Margin="12,0,0,0"/>
                </Grid>

                <TextBlock Text="分类与恢复密钥含多个值时用 &amp;n 分隔（前后各一个空格）。"
                           TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelBtn" Content="取消" MinWidth="88" Height="32"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="确定" MinWidth="88" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</local:ContentDialogBase>
