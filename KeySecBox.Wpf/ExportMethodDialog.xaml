<local:ContentDialogBase x:Class="KeySecBox.ExportMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:KeySecBox"
        Title="导出">
    <Border Background="#66000000" Padding="24">
        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                CornerRadius="8" Padding="20" Width="460"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="导出" FontSize="16" FontWeight="SemiBold"/>

                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Width="400" HorizontalAlignment="Left">
                        <TextBlock x:Name="CountText" TextWrapping="Wrap"/>

                        <TextBlock Text="导出方式" FontWeight="SemiBold" Margin="0,12,0,0"/>

                        <!-- WinUI RadioButtons -> 同 GroupName 的 RadioButton 组；
                             SelectionChanged 靠每个项的 Checked 事件汇总（见 code-behind） -->
                        <StackPanel x:Name="MethodList" Margin="0,8,0,0">
                            <RadioButton x:Name="CsvRadio" Content="CSV（明文）" GroupName="ExportMethod"
                                         Tag="Csv" Checked="OnMethodChecked"/>
                            <RadioButton x:Name="EncCsvRadio" Content="CSV（已加密）" GroupName="ExportMethod"
                                         Tag="EncryptedCsv" Margin="0,8,0,0" Checked="OnMethodChecked"/>
                            <RadioButton x:Name="DirRadio" Content="完整数据目录（明文）" GroupName="ExportMethod"
                                         Tag="DataDirectory" Margin="0,8,0,0" Checked="OnMethodChecked"/>
                            <RadioButton x:Name="EncDirRadio" Content="完整数据目录（已加密打包）" GroupName="ExportMethod"
                                         Tag="EncryptedDataDirectory" Margin="0,8,0,0" Checked="OnMethodChecked"/>
                        </StackPanel>

                        <!-- SystemFillColorCaution* 在 WPF 主题中无对应画笔：用固定警示色自绘 -->
                        <Border x:Name="PlainWarn" Background="#FFF7E0" BorderBrush="#E0B44A"
                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                            <TextBlock Foreground="#7A5300" TextWrapping="Wrap"
                                       Text="注意：明文导出的内容任何人可直接读取。请妥善保管导出文件。"/>
                        </Border>

                        <StackPanel x:Name="EncryptPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="加密密码" FontWeight="SemiBold"/>
                            <CheckBox x:Name="UseCustomPwd" Content="使用自定义密码（不勾选则沿用当前保险库密码）"
                                      Margin="0,8,0,0"
                                      Checked="OnUseCustomPwdChanged" Unchecked="OnUseCustomPwdChanged"/>
                            <ui:PasswordBox x:Name="CustomPwd" Margin="0,8,0,0" Visibility="Collapsed"
                                         ContextMenu="{x:Null}"/>
                            <ui:PasswordBox x:Name="CustomPwd2" Margin="0,8,0,0" Visibility="Collapsed"
                                         ContextMenu="{x:Null}"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="请输入保险库密码以确认导出"/>
                            <ui:PasswordBox x:Name="PasswordBox" Margin="0,6,0,0"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         ContextMenu="{x:Null}"/>
                        </StackPanel>

                        <ProgressBar x:Name="Busy" Margin="0,12,0,0" Height="4" Width="140"
                                     HorizontalAlignment="Left" Visibility="Collapsed"
                                     IsIndeterminate="True"/>
                        <TextBlock x:Name="ErrorText" Margin="0,10,0,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelBtn" Content="取消" MinWidth="88" Height="32"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="导出" MinWidth="88" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</local:ContentDialogBase>
