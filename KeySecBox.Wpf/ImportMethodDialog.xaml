<local:ContentDialogBase x:Class="KeySecBox.ImportMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeySecBox"
        Title="导入数据">
    <Border Background="#66000000" Padding="24">
        <Border Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="8" Padding="20" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="导入数据" FontSize="16" FontWeight="SemiBold"/>

                <TextBlock Text="请选择导入方式：" TextWrapping="Wrap" FontWeight="SemiBold"
                           Margin="0,14,0,0"/>

                <!-- WinUI 的 RadioButtons 控件在 WPF 中不存在：改用同一 GroupName 的 RadioButton 组 -->
                <StackPanel x:Name="MethodList" Margin="0,12,0,0">
                    <RadioButton x:Name="CsvRadio" Content="导入 CSV（.csv / .csvenc）"
                                 GroupName="ImportMethod" Tag="Csv" IsChecked="True"/>
                    <RadioButton x:Name="JsonRadio" Content="导入 JSON（.json）"
                                 GroupName="ImportMethod" Tag="Json" Margin="0,8,0,0"/>
                    <RadioButton x:Name="LegacyRadio" Content="导入旧版库（1.0.x）"
                                 GroupName="ImportMethod" Tag="Legacy" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock Text="CSV 与 JSON 使用高级导入：可指定字段对应的键名，并预览原始内容。"
                           TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelBtn" Content="取消" MinWidth="88" Height="32"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="确定" MinWidth="88" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</local:ContentDialogBase>
